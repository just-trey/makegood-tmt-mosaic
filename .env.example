# Umami analytics website ID.
# - Local builds: copy this file to `.env.local` (gitignored) and fill in the website ID to
#   build your dist with analytics enabled.
# - Deploys: set a GitHub repo Variable named UMAMI_WEBSITE_ID (Settings → Secrets and variables
#   → Actions → Variables); the deploy workflow passes it to the build.
# Leave it unset and the script is simply not injected — which is what forks get.
UMAMI_WEBSITE_ID=

# Formspree endpoint the in-app feedback widget posts to.
# - Local builds: copy this file to `.env.local` (gitignored) and fill in the form URL to see and
#   test the widget.
# - Deploys: set a GitHub repo Variable named FEEDBACK_ENDPOINT (a form URL is public by design,
#   so a Variable, not a Secret); the deploy workflow passes it to the build.
# Leave it unset and the widget is not rendered at all — which is what forks get.
FEEDBACK_ENDPOINT=
